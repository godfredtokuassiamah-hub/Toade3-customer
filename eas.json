{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "uploadSourceMaps": false
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "uploadSourceMaps": false
    }
  },
  "submit": {
    "production": {}
  }
}
