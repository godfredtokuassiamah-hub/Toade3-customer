# Copy to .env and fill in from Supabase: Project Settings > API / API Keys.
# The publishable key is public by design (it ships in the app bundle);
# row level security policies are what protect the data.
# Never put a secret / service_role key or the database password here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Optional. Place search/reverse geocoding base URL (Photon API). Defaults to
# the public https://photon.komoot.io (fair-use only); point at a self-hosted
# Photon for production. No trailing path, e.g. https://photon.example.com
EXPO_PUBLIC_PLACES_BASE_URL=

# DEV-ONLY login (src/lib/auth/devLogin.ts). Works only in development
# (__DEV__), never in release builds. Sign in with this email, then enter this
# 6-digit code; no email is sent and nothing is written to Supabase.
# Leave blank to disable.
EXPO_PUBLIC_DEV_LOGIN_EMAIL=
EXPO_PUBLIC_DEV_LOGIN_CODE=
